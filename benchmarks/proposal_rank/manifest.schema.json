{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProposalRankManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ids_sha256", "cases"],
  "properties": {
    "version": {"const": 1},
    "ids_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "seed": {"type": "string"},
    "source": {"type": "object"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["forum", "split"],
        "properties": {
          "forum": {"type": "string", "minLength": 1},
          "split": {"enum": ["test", "dev", "holdout"]},
          "key": {"type": "string"},
          "year": {"type": "integer"},
          "rating_scale": {"type": "string"},
          "arxiv": {"type": "string"},
          "arxiv_id": {"type": "string"},
          "stratum": {"type": "string"},
          "cutoff_ms": {"type": "integer"},
          "submission_ms": {"type": "integer"}
        }
      }
    }
  }
}
