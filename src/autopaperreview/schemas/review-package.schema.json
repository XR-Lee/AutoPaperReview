{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "generated_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated By"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "role"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "DimensionScore": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "$ref": "#/$defs/SarDimension"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "rationale": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "route_ids": {
          "items": {
            "type": "string"
          },
          "title": "Route Ids",
          "type": "array"
        },
        "score": {
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "dimension",
        "score",
        "evidence_ids"
      ],
      "title": "DimensionScore",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "excerpt_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt Hash"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "retrieval_query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Query"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_id",
        "locator",
        "claim"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "default": "en",
          "minLength": 2,
          "title": "Language",
          "type": "string"
        },
        "primary": {
          "minLength": 1,
          "title": "Primary",
          "type": "string"
        },
        "translations": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Translations",
          "type": "object"
        }
      },
      "required": [
        "primary"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "OverallScore": {
      "additionalProperties": false,
      "properties": {
        "coefficient_set": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coefficient Set"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "method": {
          "$ref": "#/$defs/OverallScoreMethod"
        },
        "model_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Identifier"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "prompt_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Hash"
        },
        "scale_max": {
          "default": 10.0,
          "title": "Scale Max",
          "type": "number"
        },
        "scale_min": {
          "default": 0.0,
          "title": "Scale Min",
          "type": "number"
        },
        "scorer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scorer"
        },
        "value": {
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "method"
      ],
      "title": "OverallScore",
      "type": "object"
    },
    "OverallScoreMethod": {
      "enum": [
        "linear_regression",
        "declared_formula",
        "human",
        "llm_direct"
      ],
      "title": "OverallScoreMethod",
      "type": "string"
    },
    "QueryPerspective": {
      "enum": [
        "baselines",
        "same_problem",
        "related_techniques"
      ],
      "title": "QueryPerspective",
      "type": "string"
    },
    "RelatedWorkQuery": {
      "additionalProperties": false,
      "properties": {
        "generated_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated From"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "perspective": {
          "$ref": "#/$defs/QueryPerspective"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "id",
        "perspective",
        "query"
      ],
      "title": "RelatedWorkQuery",
      "type": "object"
    },
    "RetrievedSourceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "arxiv_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arxiv Id"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "content_kind": {
          "$ref": "#/$defs/SnapshotContentKind"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "query_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Query Ids",
          "type": "array"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "query_ids",
        "title",
        "retrieved_at",
        "content_kind",
        "locator"
      ],
      "title": "RetrievedSourceSnapshot",
      "type": "object"
    },
    "ReviewClaim": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ReviewClaimKind"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "route_ids": {
          "items": {
            "type": "string"
          },
          "title": "Route Ids",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "text": {
          "$ref": "#/$defs/LocalizedText"
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "evidence_ids"
      ],
      "title": "ReviewClaim",
      "type": "object"
    },
    "ReviewClaimKind": {
      "enum": [
        "summary",
        "strength",
        "weakness",
        "question",
        "comment"
      ],
      "title": "ReviewClaimKind",
      "type": "string"
    },
    "ReviewDecision": {
      "enum": [
        "open",
        "accepted",
        "rejected",
        "superseded"
      ],
      "title": "ReviewDecision",
      "type": "string"
    },
    "ReviewIssue": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "consensus_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consensus Key"
        },
        "decision": {
          "$ref": "#/$defs/ReviewDecision",
          "default": "open"
        },
        "evidence": {
          "$ref": "#/$defs/LocalizedText"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "impact": {
          "$ref": "#/$defs/LocalizedText"
        },
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "required_action": {
          "$ref": "#/$defs/LocalizedText"
        },
        "route_ids": {
          "items": {
            "type": "string"
          },
          "title": "Route Ids",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "support_count": {
          "default": 1,
          "minimum": 1,
          "title": "Support Count",
          "type": "integer"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/LocalizedText"
        }
      },
      "required": [
        "id",
        "severity",
        "category",
        "title",
        "location",
        "evidence",
        "impact",
        "required_action",
        "confidence"
      ],
      "title": "ReviewIssue",
      "type": "object"
    },
    "ReviewRoute": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RouteKind"
        },
        "manuscript_access": {
          "default": true,
          "title": "Manuscript Access",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "network_access": {
          "default": false,
          "title": "Network Access",
          "type": "boolean"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "title": "ReviewRoute",
      "type": "object"
    },
    "RouteKind": {
      "enum": [
        "prompt",
        "deterministic",
        "executable",
        "literature",
        "visual",
        "human"
      ],
      "title": "RouteKind",
      "type": "string"
    },
    "SarDimension": {
      "enum": [
        "originality",
        "importance_of_research_question",
        "claims_supported",
        "experimental_soundness",
        "writing_clarity",
        "community_value",
        "prior_work_contextualization"
      ],
      "title": "SarDimension",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "major",
        "moderate",
        "minor",
        "editorial"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SnapshotContentKind": {
      "enum": [
        "abstract",
        "full_text_summary"
      ],
      "title": "SnapshotContentKind",
      "type": "string"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "properties": {
        "accessed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessed At"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "locator"
      ],
      "title": "SourceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptance_gate": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Acceptance Gate",
      "type": "object"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/ReviewClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "dimension_scores": {
      "items": {
        "$ref": "#/$defs/DimensionScore"
      },
      "title": "Dimension Scores",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ReviewIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "manuscript": {
      "$ref": "#/$defs/Artifact"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "overall_score": {
      "anyOf": [
        {
          "$ref": "#/$defs/OverallScore"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "recommendation": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalizedText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "related_work_queries": {
      "items": {
        "$ref": "#/$defs/RelatedWorkQuery"
      },
      "title": "Related Work Queries",
      "type": "array"
    },
    "retrieved_snapshots": {
      "items": {
        "$ref": "#/$defs/RetrievedSourceSnapshot"
      },
      "title": "Retrieved Snapshots",
      "type": "array"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/ReviewRoute"
      },
      "title": "Routes",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRecord"
      },
      "title": "Sources",
      "type": "array"
    },
    "strengths": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Strengths",
      "type": "object"
    },
    "summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalizedText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "project_id",
    "manuscript"
  ],
  "title": "ReviewPackage",
  "type": "object"
}
