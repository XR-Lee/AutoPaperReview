    "AgendaQuestion": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "perspective": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryPerspective"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "requires_network": {
          "default": false,
          "title": "Requires Network",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "question"
      ],
      "title": "AgendaQuestion",
      "type": "object"
    },
    "Anchor": {
      "additionalProperties": false,
      "description": "Machine-readable locator. `display` remains the human-readable location.",
