{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "description": "Machine-readable locator. `display` remains the human-readable location.",
      "properties": {
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "display": {
          "minLength": 1,
          "title": "Display",
          "type": "string"
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encoding"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "excerpt_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt Hash"
        },
        "kind": {
          "$ref": "#/$defs/AnchorKind"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        },
        "start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "required": [
        "kind",
        "display"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "AnchorKind": {
      "enum": [
        "display",
        "text_offset",
        "quote",
        "pdf_region",
        "docx_paragraph",
        "external_snapshot"
      ],
      "title": "AnchorKind",
      "type": "string"
    },
    "CommentIntent": {
      "description": "Conventional Comments-style intent. Optional; reports remain readable without it.",
      "enum": [
        "praise",
        "issue",
        "suggestion",
        "question",
        "note"
      ],
      "title": "CommentIntent",
      "type": "string"
    },
    "FirstReadNote": {
      "additionalProperties": false,
      "description": "Self-contained argument for a reader who is seeing the paper for the first time.",
      "properties": {
        "blocking": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocking"
        },
        "explanation": {
          "$ref": "#/$defs/LocalizedText"
        },
        "intent": {
          "$ref": "#/$defs/CommentIntent",
          "default": "issue"
        },
        "paper_said": {
          "$ref": "#/$defs/LocalizedText"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "paper_said",
        "explanation"
      ],
      "title": "FirstReadNote",
      "type": "object"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "default": "en",
          "minLength": 2,
          "title": "Language",
          "type": "string"
        },
        "primary": {
          "minLength": 1,
          "title": "Primary",
          "type": "string"
        },
        "translations": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Translations",
          "type": "object"
        }
      },
      "required": [
        "primary"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "ReviewDecision": {
      "enum": [
        "open",
        "accepted",
        "rejected",
        "superseded"
      ],
      "title": "ReviewDecision",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "major",
        "moderate",
        "minor",
        "editorial"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "anchor": {
      "anyOf": [
        {
          "$ref": "#/$defs/Anchor"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "category": {
      "minLength": 1,
      "title": "Category",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "consensus_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consensus Key"
    },
    "decision": {
      "$ref": "#/$defs/ReviewDecision",
      "default": "open"
    },
    "evidence": {
      "$ref": "#/$defs/LocalizedText"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "first_read": {
      "anyOf": [
        {
          "$ref": "#/$defs/FirstReadNote"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
      "title": "Id",
      "type": "string"
    },
    "impact": {
      "$ref": "#/$defs/LocalizedText"
    },
    "location": {
      "minLength": 1,
      "title": "Location",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "required_action": {
      "$ref": "#/$defs/LocalizedText"
    },
    "route_ids": {
      "items": {
        "type": "string"
      },
      "title": "Route Ids",
      "type": "array"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "support_count": {
      "default": 1,
      "minimum": 1,
      "title": "Support Count",
      "type": "integer"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "title": {
      "$ref": "#/$defs/LocalizedText"
    }
  },
  "required": [
    "id",
    "severity",
    "category",
    "title",
    "location",
    "evidence",
    "impact",
    "required_action",
    "confidence"
  ],
  "title": "ReviewIssue",
  "type": "object"
}
